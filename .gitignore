# ════════════════════════════════════════════════════
#  .gitignore — Manowzab Vision
# ════════════════════════════════════════════════════

# ─── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ─── Virtual Environment ─────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.Python

# ─── Build / Packaging ───────────────────────────────
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# ─── PyInstaller ─────────────────────────────────────
*.manifest
*.spec

# ─── Testing / Coverage ──────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ─── Jupyter ─────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Logs ────────────────────────────────────────────
*.log
logs/
pip-log.txt
pip-delete-this-directory.txt

# ─── Secrets & Config ────────────────────────────────
.env
.env.local
.env.*.local
# เก็บ .env.example ไว้เป็น template สำหรับ contributor

# ─── ML Models & Large Binary Files ─────────────────
*.pt
*.pth
*.onnx
*.engine
*.bin
*.weights
*.h5
*.pkl
models/

# ─── Video / Audio Files ─────────────────────────────
*.mp4
*.avi
*.mkv
*.mov
*.flv
*.webm
*.mp3
*.wav

# ─── Image Datasets & Output ─────────────────────────
# ข้อมูลดิบ / ผลลัพธ์ที่ generate ได้
captured_images/
data/raw_frames/
data/needs_training/
data/needs_training-BK/
data/train/images/
data/train/labels/

# เก็บ data/data.yaml และ README.roboflow.txt ไว้ (config สำคัญ)
!data/data.yaml
!data/README.roboflow.txt

# ─── YOLO Training Runs ──────────────────────────────
runs/

# ─── Active Learning Dumps ───────────────────────────
needs_training/
al_*.jpg

# ─── Installer / Package Cache ───────────────────────
*.installer

# ─── OS Specific ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE / Editor ────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─── Temporary Files ─────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
