# ─────────────────────────────────────────────────────────────────
# Manowzab Vision — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าให้ครบ
# ─────────────────────────────────────────────────────────────────

# ── Webhook ──────────────────────────────────────────────────────
# URL ปลายทางที่รับข้อมูล JSON เมื่อตรวจพบสินค้าและจับภาพสำเร็จ
WEBHOOK_URL=https://your-app.example.com/api/product-event

# ── Whisper (Speech-to-Text) ─────────────────────────────────────
WHISPER_MODEL_SIZE=medium        # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cuda              # cuda | cpu
WHISPER_COMPUTE=float16          # float16 (GPU) | int8 (CPU)
TARGET_LANGUAGE=th               # th = ภาษาไทย

# ── Audio Chunk ───────────────────────────────────────────────────
CHUNK_SECONDS=10
SAMPLE_RATE=16000

# ── Computer Vision ───────────────────────────────────────────────
YOLO_MODEL_NAME=yolov8n.pt       # yolov8n | yolov8s | yolov8m
CAPTURE_DURATION=3.0             # วินาทีที่จับภาพหลัง trigger
CAPTURE_FPS_TARGET=10            # เฟรมต่อวินาทีระหว่างจับ
BLUR_THRESHOLD=80.0              # Variance of Laplacian ต่ำกว่านี้ = เบลอ
VIDEO_FRAME_W=1280
VIDEO_FRAME_H=720
OUTPUT_DIR=captured_images       # โฟลเดอร์สำหรับบันทึกภาพ

# ── API Server ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── NLP Engine (Ollama) ────────────────────────────────────────────
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5
